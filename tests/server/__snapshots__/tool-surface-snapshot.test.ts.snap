                "type": "string",
              },
            },
            "required": [
              "text",
              "status",
            ],
            "type": "object",
          },
          "maxItems": 30,
          "type": "array",
        },
        "progress": {
          "description": "One-paragraph progress summary",
          "maxLength": 2000,
          "type": "string",
        },
        "replacePending": {
          "description": "Replace the pending list instead of appending",
          "type": "boolean",
        },
        "sessionId": {
          "description": "Session id; defaults to the session this connection started or resumed",
          "type": "string",
        },
        "task": {
          "maxLength": 2000,
          "type": "string",
        },
