    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "workspace_snapshot",
    "title": "Workspace Snapshot",
  },
]
`;

