    "name": "baton_session_context",
    "title": "Session Context",
  },
  {
    "_meta": undefined,
    "annotations": undefined,
    "description": "End a coding session with a structured summary. This summary will be injected into the next session so the next agent can resume work seamlessly.

Recommended summary format:
## Goal
[What we were working on]

## Discoveries
- [Technical findings, gotchas, learnings]

## Accomplished
- [OK] [Completed tasks]
- [PENDING] [Pending for next session]

## Relevant Files
- path/to/file — [what changed]",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "description": "Session ID to close (from baton_session_start)",
          "type": "string",
        },
        "summary": {
          "description": "Structured session summary (Goal/Discoveries/Accomplished/Files format)",
          "type": "string",
        },
      },
      "required": [
        "sessionId",
      ],
      "type": "object",
    },
    "name": "baton_session_end",
    "title": "End Session",
  },
  {
    "_meta": undefined,
    "annotations": undefined,
    "description": "Start a new coding session. Returns a compact continuation card with the latest handoff and a few memory references. Call this at the beginning of a session to track activity; retrieve a referenced memory only when it is relevant. Any previous active session for this project will be auto-closed. By default this is lightweight: it binds the project, opens a session, and avoids dumping full history into the new context. Coordination identity is opt-in via \`joinTeam: true\` or a separate \`team_manage\` join call.

IMPORTANT for HTTP/control-plane mode: pass \`projectRoot\` with the absolute path to your workspace root (e.g., the directory open in your IDE). Baton uses this to detect the git project and bind this session to the correct project context. Without it, project-scoped tools will be disabled.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "description": "Agent/IDE name (e.g., "cursor", "windsurf", "claude-code")",
          "type": "string",
        },
        "agentType": {
          "description": "Agent type used for optional coordination identity mapping (e.g., "windsurf", "cursor").",
          "type": "string",
        },
        "instanceId": {
          "description": "Stable instance ID for optional coordination identity across restarts. If omitted with joinTeam=true, Baton derives a deterministic fallback from the project and agent identity.",
          "type": "string",
        },
        "joinTeam": {
          "description": "If true, also join orchestration coordination state for this session. Defaults to false.",
          "type": "boolean",
        },
        "model": {
          "description": "Baton: model you run on, e.g. claude-opus or gpt-5",
          "maxLength": 100,
          "type": "string",
        },
        "modelProvider": {
          "description": "Baton: model provider, e.g. anthropic or openai",
          "maxLength": 100,
          "type": "string",
        },
        "objective": {
          "description": "Baton: when the task counts as done",
          "maxLength": 4000,
          "type": "string",
        },
        "projectRoot": {
          "description": "Absolute path to the workspace/project root directory (e.g., the folder open in your IDE). Baton will detect the git project from this path and bind this session to it. Required for HTTP transport when multiple projects are open simultaneously or when rebinding an existing control-plane session.",
          "type": "string",
        },
        "role": {
          "description": "Explicit role override used only when joinTeam=true.",
          "type": "string",
        },
        "sessionId": {
          "description": "Custom session ID (auto-generated if omitted)",
          "type": "string",
        },
        "task": {
          "description": "Baton: the task this session works on (enables handoff/resume by others)",
          "maxLength": 2000,
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "baton_session_start",
    "title": "Start Session",
  },
  {
    "_meta": undefined,
    "annotations": undefined,
    "description": "Store a new observation/memory. Automatically indexed for search. Use type to classify: gotcha ([GOTCHA] critical pitfall), decision ([DECISION] architecture choice), problem-solution ([FIX] bug fix), how-it-works ([INFO] explanation), what-changed ([CHANGE] change), discovery ([DISCOVERY] insight), why-it-exists ([WHY] rationale), trade-off ([TRADEOFF] compromise), session-request ([SESSION] original goal). Project visibility is the default. Personal or team visibility requires an explicitly joined coordination identity. Set longTerm only when the caller explicitly wants an additional source-backed long-term candidate; it is never injected until an operator records a review through the CLI. For a read-only task, do not store unless the user explicitly asks to save a record.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "attachments": {
          "description": "Safe public provenance references. They are stored as metadata for lexical retrieval; raw inline media is never stored.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "mimeType": {
                "type": "string",
              },
              "modality": {
                "enum": [
                  "image",
                  "audio",
                  "video",
                  "document",
                ],
                "type": "string",
              },
              "name": {
                "type": "string",
              },
              "url": {
                "description": "Public HTTPS provenance reference without query parameters or fragments. Baton does not fetch this URL: attachment metadata is persisted and BM25-searchable, while observation vectors remain text-only.",
                "type": "string",
              },
            },
            "required": [
              "modality",
              "url",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "concepts": {
          "description": "Related concepts/keywords",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "entityName": {
          "description": "The entity this observation belongs to (e.g., "auth-module", "port-config")",
          "type": "string",
        },
        "facts": {
          "description": "Structured facts (e.g., "Default timeout: 60s")",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "filesModified": {
          "description": "Files involved",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "longTerm": {
          "additionalProperties": false,
          "description": "Optional explicit request to create a source-backed long-term candidate alongside this observation. Candidates are not automatically injected.",
          "properties": {
            "applicability": {
              "description": "When this durable fact or procedure applies.",
              "type": "string",
            },
            "kind": {
              "description": "Cognitive kind for an additional long-term candidate.",
              "enum": [
                "episodic",
                "semantic",
                "procedural",
              ],
              "type": "string",
            },
            "scope": {
              "default": "project",
              "description": "Long-term scope. User capture is private source evidence and needs a bound agent identity.",
              "enum": [
                "project",
                "user",
                "team",
              ],
              "type": "string",
            },
            "tags": {
              "description": "Small set of retrieval tags for the candidate.",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
          },
          "required": [
            "kind",
          ],
          "type": "object",
        },
        "narrative": {
          "description": "Full description of the observation",
          "type": "string",
        },
        "overrideReadOnly": {
          "description": "Use only when the user explicitly asks to save memory during a read-only or no-modification task.",
          "type": "boolean",
        },
        "progress": {
          "additionalProperties": false,
          "description": "Progress tracking for task/feature observations",
          "properties": {
            "completion": {
              "description": "Completion percentage 0-100",
              "type": "number",
            },
            "feature": {
              "description": "Feature or task name",
              "type": "string",
            },
            "status": {
              "description": "Current status",
              "enum": [
                "in-progress",
                "completed",
                "blocked",
              ],
              "type": "string",
            },
          },
          "required": [
            "feature",
            "status",
          ],
          "type": "object",
        },
        "relatedCommits": {
          "description": "Git commit hashes this memory relates to (links ground truth ↔ reasoning)",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "relatedEntities": {
          "description": "Other entity names this memory cross-references",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "title": {
          "description": "Short descriptive title (~5-10 words)",
          "type": "string",
        },
        "topicKey": {
          "description": "Optional topic identifier for upserts (e.g., "architecture/auth-model"). If an observation with the same topicKey already exists in this project, it will be UPDATED instead of creating a new one. Use baton_suggest_topic_key to generate a stable key. Good for evolving decisions, architecture docs, etc.",
          "type": "string",
        },
        "type": {
          "description": "Observation type for classification",
          "enum": [
            "session-request",
            "gotcha",
            "problem-solution",
            "reasoning",
            "how-it-works",
            "what-changed",
            "discovery",
            "why-it-exists",
            "decision",
            "trade-off",
            "probe",
          ],
          "type": "string",
        },
        "visibility": {
          "description": "Retrieval scope. Project is the normal shared default; personal/team require baton_session_start with joinTeam=true.",
          "enum": [
            "personal",
            "project",
            "team",
          ],
          "type": "string",
        },
      },
      "required": [
        "entityName",
        "type",
        "title",
        "narrative",
      ],
      "type": "object",
    },
    "name": "baton_store",
    "title": "Store Memory",
  },
  {
    "_meta": undefined,
    "annotations": undefined,
    "description": "Store a reasoning trace — WHY you chose this approach, what alternatives you considered, and what outcome you expect. This creates a searchable record of your decision-making process. Use this when making non-trivial technical decisions, choosing between approaches, or solving complex problems. Unlike regular memories that record WHAT happened, reasoning memories record HOW you thought about it.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "description": "Other options that were considered",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "concepts": {
          "description": "Related technical concepts",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "constraints": {
          "description": "Constraints that influenced the decision (time, perf, compat, etc.)",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "decision": {
          "description": "What was decided or chosen",
          "type": "string",
        },
        "entityName": {
          "description": "The entity this reasoning applies to (e.g., "auth-module", "database-schema")",
          "type": "string",
        },
        "expectedOutcome": {
          "description": "What outcome is expected from this decision",
          "type": "string",
        },
        "filesModified": {
          "description": "Files related to this reasoning",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "rationale": {
          "description": "Why this approach was chosen over alternatives",
          "type": "string",
        },
        "relatedCommits": {
          "description": "Git commit hashes this reasoning explains (links ground truth ↔ reasoning)",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "relatedEntities": {
          "description": "Other entity names this reasoning relates to (cross-references)",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "risks": {
          "description": "Known risks or potential downsides",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
      },
      "required": [
        "entityName",
        "decision",
        "rationale",
      ],
      "type": "object",
    },
    "name": "baton_store_reasoning",
    "title": "Store Reasoning Trace",
