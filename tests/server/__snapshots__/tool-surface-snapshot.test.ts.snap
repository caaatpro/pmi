  {
    "_meta": undefined,
    "annotations": undefined,
    "description": "Search project memory. Returns a compact index (~50-100 tokens/result). Do not use as a follow-up to a complete baton_project_context brief unless a specific fact is still missing or the user asks for deeper history; provide purpose when intentionally expanding. Use baton_detail to fetch full content for specific IDs. Use baton_timeline to see chronological context. Searches across all observations stored from any IDE session — enabling cross-session and cross-agent context retrieval.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "force": {
          "description": "Use only when the user explicitly asks to read a record already represented in the latest Autopilot brief.",
          "type": "boolean",
        },
        "limit": {
          "description": "Max results (default: 20)",
          "type": "number",
        },
        "maxTokens": {
          "description": "Token budget — trim results to fit (0 = unlimited)",
          "type": "number",
        },
        "purpose": {
          "description": "Why this must expand beyond the latest Autopilot brief. Name the missing fact or the user's explicit request.",
          "type": "string",
        },
        "quality": {
          "default": "balanced",
          "description": "Retrieval profile: fast stays local, balanced uses configured embeddings, thorough explicitly permits optional LLM refinement.",
          "enum": [
            "fast",
            "balanced",
            "thorough",
          ],
          "type": "string",
        },
        "query": {
          "description": "Search query (natural language or keywords)",
          "type": "string",
        },
        "scope": {
          "default": "project",
          "description": "Search scope: "project" (default) only searches current project, "global" searches all projects",
          "enum": [
            "project",
            "global",
          ],
          "type": "string",
        },
        "since": {
          "description": "Only return observations created after this date (ISO 8601 or natural like "2025-01-15")",
          "type": "string",
        },
        "source": {
          "description": "Filter by memory source. "git" returns only commit-derived ground truth memories. Omit for all sources.",
          "enum": [
            "agent",
            "git",
            "manual",
          ],
          "type": "string",
        },
        "status": {
          "default": "active",
          "description": "Filter by memory status. "active" (default) shows current memories, "all" includes resolved/archived.",
          "enum": [
            "active",
            "resolved",
            "archived",
            "all",
          ],
          "type": "string",
        },
        "type": {
          "description": "Filter by observation type",
          "enum": [
            "session-request",
            "gotcha",
            "problem-solution",
            "reasoning",
            "how-it-works",
            "what-changed",
            "discovery",
            "why-it-exists",
            "decision",
            "trade-off",
            "probe",
          ],
          "type": "string",
        },
        "until": {
          "description": "Only return observations created before this date (ISO 8601 or natural like "2025-02-01")",
          "type": "string",
        },
      },
      "required": [
        "query",
      ],
      "type": "object",
    },
    "name": "baton_search",
    "title": "Search Memory",
  },
  {
    "_meta": undefined,
    "annotations": undefined,
    "description": "Search past reasoning traces to understand WHY decisions were made. Returns reasoning memories that explain the thought process behind technical choices. Use this when revisiting code, questioning a design decision, or looking for precedent on how similar problems were solved before.",
