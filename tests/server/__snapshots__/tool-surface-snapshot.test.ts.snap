  },
  {
    "_meta": undefined,
    "annotations": undefined,
    "description": "Save the state of the current task so anyone can continue it if this session stops: what is done, what is pending, the next action and open problems. The working copy (branch, HEAD, changed files) is recorded automatically. Call it after finishing a meaningful step; file changes are also checkpointed by the Baton daemon without you.",
    "execution": {
      "taskSupport": "forbidden",
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "completed": {
          "description": "Steps finished since the last update (remove them from pending)",
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 50,
          "type": "array",
        },
        "decisions": {
          "description": "Memories (architecture decisions) this session relies on",
          "items": {
